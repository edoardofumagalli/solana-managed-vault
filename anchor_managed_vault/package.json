  "scripts": {
    "lint:fix": "prettier */*.js \"*/**/*{.js,.ts}\" -w",
    "lint": "prettier */*.js \"*/**/*{.js,.ts}\" --check",
    "test:kamino:surfpool": "RUN_SURFPOOL_KAMINO=1 npx ts-mocha -p ./tsconfig.json -t 1000000 \"tests/kamino_surfpool_smoke.ts\"",
    "discover:kamino:oracles": "cargo test -p kamino_yield_module --test kamino_oracle_discovery -- --ignored --nocapture",
    "test:kamino:surfpool:deposit": "RUN_SURFPOOL_KAMINO=1 npx ts-mocha -p ./tsconfig.json -t 1000000 \"tests/kamino_surfpool_deposit.ts\"",
    "surfpool:write:vault": "npx ts-node --transpile-only scripts/surfpool-write-program.ts anchor_managed_vault",
    "surfpool:write:kamino": "npx ts-node --transpile-only scripts/surfpool-write-program.ts kamino_yield_module",
    "surfpool:write:mock": "npx ts-node --transpile-only scripts/surfpool-write-program.ts mock_yield_module"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1"
  },
  "devDependencies": {
    "@solana/spl-token": "^0.4.14",
    "@types/bn.js": "^5.1.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^9.0.0",
    "chai": "^4.3.4",
    "mocha": "^9.0.3",
    "prettier": "^2.6.2",
    "ts-mocha": "^10.0.0",
    "typescript": "^5.7.3"
  }
}
